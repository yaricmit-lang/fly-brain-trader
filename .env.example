# Copy to .env and fill in. The .env file is never committed to git.

# --- External demo exchanges: optional ---
# The default executor is the built-in paper simulator, so the keys below
# are not required. The Binance and Bybit adapters are kept behind the common
# `Adapter` interface; availability of their demo/testnet environments depends
# on account verification requirements and your region. To use one, fill in
# the matching pair and set trading.executor.adapter in config/default.yaml.
BYBIT_DEMO_KEY=
BYBIT_DEMO_SECRET=
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# --- FlyWire CAVE (only needed for neuron skeletons; currently unused) ---
# Sign in with Google at https://global.daf-apis.com/auth/api/v1/user/token
CAVE_TOKEN=

# --- Groq (only needed for news sentiment features; currently unused) ---
# Free API key: https://console.groq.com
GROQ_API_KEY=
