# --- secrets (never commit) ---
.env
*.key
*.pem

# --- large data and run outputs ---
# (the .nosync suffix also keeps iCloud from syncing these folders on macOS)
data.nosync/
runs.nosync/
*.parquet
*.npz
*.pt
*.sqlite
*.sqlite3

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# --- frontend ---
web/node_modules/
web/.next/
web/out/
node_modules/

# --- macOS ---
.DS_Store
